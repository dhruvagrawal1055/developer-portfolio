# Email Service Configuration for Portfolio Contact Form
# Copy this file to '.env' and fill in your preferred service key.

# Option 1: Web3Forms (Recommended - Free & 0 Setup at https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Option 2: EmailJS (https://emailjs.com)
# VITE_EMAILJS_SERVICE_ID=your_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Option 3: Formspree (https://formspree.io)
# VITE_FORMSPREE_FORM_ID=your_form_id
